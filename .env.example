# Copy to .env.local (or set in your host's build settings).
# Registrations default to CLOSED. To re-open, set BOTH:
#   VITE_REGISTRATION_STATUS=open
#   VITE_REGISTRATION_URL=https://your-form-url
VITE_REGISTRATION_STATUS=
VITE_REGISTRATION_URL=
# Optional canonical site URL used for social-sharing metadata at build time.
VITE_SITE_URL=
